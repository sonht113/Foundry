{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=lstchobqibbqlqvxcaon",
      "enabled": true
    },

    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"]
    },

    "foundry": {
      "type": "local",
      "command": [
        "node",
        "D:/Work/Task_Kanban/Foundry/apps/mcp-server/dist/server.js",
        "--backend",
        "pglite"
      ],
      "enabled": true,
      "environment": {
        "PGLITE_DATA_DIR": "Foundry/.pglite"
      }
    }
  }
}
