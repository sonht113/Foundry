# Supabase Configuration
# Copy this file to .env and fill in your Supabase project values

# Database backend: "supabase" (default, cloud) or "sqlite" (local/offline)
# When set to "sqlite", no Supabase credentials are needed.
DATABASE_BACKEND=supabase

# --- Supabase (used when DATABASE_BACKEND=supabase) ---

# Supabase connection (used by @supabase/supabase-js for future real-time features)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# PostgreSQL direct connection string (used by Drizzle ORM + pg)
# Get this from Supabase Dashboard → Project Settings → Database → Connection string
# Use the Session Pooler (port 6543) for serverless/connection-heavy environments
# Use the Transaction Pooler (port 5432) for direct connections
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- SQLite (used when DATABASE_BACKEND=sqlite) ---

# File path for the SQLite database  
# Default: %APPDATA%/Foundry/foundry.db (persistent)
SQLITE_DATA_DIR=./foundry.db

