{
  "name": "@foundry/electron",
  "version": "0.3.3",
  "description": "AI-Native Task Manager — Foundry",
  "repository": "https://github.com/sonht113/Foundry",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "tsc -p tsconfig.node.json && tsc-alias -p tsconfig.node.json && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron dist/main/index.js",
    "dev": "concurrently -n vite,electron -c blue,green \"npm run dev:vite\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json && tsc-alias -p tsconfig.node.json",
    "build": "npm run build:renderer && npm run build:main",
    "pack:win": "npm run build && electron-builder --win",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:linux": "npm run build && electron-builder --linux",
    "pack:all": "npm run build && electron-builder --mac --linux --win",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@foundry/database": "workspace:*",
    "@foundry/domain": "workspace:*",
    "@foundry/mcp-server": "workspace:*",
    "@foundry/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.0.0",
    "lucide-react": "^1.17.0",
    "nanoid": "^3.3.12",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^34.5.8",
    "electron-builder": "^25.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.0.0",
    "wait-on": "^9.0.10"
  }
}
